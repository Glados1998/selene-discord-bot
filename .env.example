DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
# Exact role allowed to use administrator commands (including /status).
ADMIN_ROLE_ID=

# Required for /reminder-check; use IDs, not role names. Enable Server Members Intent in the Developer Portal.
GUILD_LEADER_ROLE_ID=
REMINDER_CHANNEL_ID=

# Weekly schedule in Europe/Amsterdam (automatically follows daylight saving time).
# Set REMINDERS_ENABLED=true to enable the schedule.
REMINDERS_ENABLED=false
FRIDAY_REMINDER_TIME=20:00
MONDAY_REMINDER_TIME=20:00
